# Real recordings: where somebody was, minute by minute. They are for
# checking by hand and never enter a commit, a fixture or a doc -- tests
# build synthetic courses instead.
example_files/
/*.fit
/*.FIT
/*.gpx
/*.kml
/*.kmz
/*.tcx

# Session output: renders, captured diffs, inspected frames.
.scratch/

# Maps "course map" writes, by default into the directory it is run in. A
# map of a real recording is that recording drawn, and is kept out of the
# repository with it.
/*.png

# The built command.
/course
